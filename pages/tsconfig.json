{
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "~components/*": ["../lib/components/*"],
      "~global-styles": ["../global-styles/src"],
      "~global-styles/*": ["../global-styles/src/*"],
      "~collection-hooks": ["../collection-hooks/src"]
    }
  },
  "include": ["."]
}
