{
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": "src",
    "outDir": "lib/components"
  },
  "include": ["src", "types"],
  "exclude": ["**/__tests__/**"]
}
