{
  "name": "@ordinate/global-styles",
  "version": "0.1.0",
  "description": "Fonts, base styles and the mode and revision helpers for Ordinate.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./index.css": "./lib/index.css",
    "./drawing-fonts.css": "./lib/drawing-fonts.css"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('node:fs');fs.copyFileSync('src/index.css','lib/index.css');fs.copyFileSync('src/drawing-fonts.css','lib/drawing-fonts.css');fs.cpSync('src/fonts','lib/fonts',{recursive:true})\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0"
  }
}
