{
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": "src",
    "outDir": "../lib/charts",
    "paths": {
      "@ordinate-ui/components/*": ["../lib/components/*"],
      "@ordinate-ui/design-tokens": ["../lib/design-tokens"]
    }
  },
  "include": ["src", "../types"],
  "exclude": ["**/__tests__/**"]
}
