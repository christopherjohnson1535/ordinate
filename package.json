{
  "name": "@ordinate/components",
  "version": "0.1.0",
  "description": "A schematic React component library with pinnable design revisions.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/christopherjohnson1535/ordinate.git"
  },
  "private": true,
  "workspaces": [
    "global-styles"
  ],
  "files": [],
  "scripts": {
    "build": "gulp build",
    "start": "npm-run-all --parallel start:watch start:dev",
    "start:watch": "gulp watch",
    "start:dev": "vite --config pages/vite.config.mjs",
    "build:pages": "vite build --config pages/vite.config.mjs",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.unit.config.mjs",
    "lint": "npm-run-all --parallel lint:*",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint --ignore-path .gitignore \"{src,pages}/**/*.scss\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tony.ganchev/eslint-plugin-header": "^3.4.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "gulp": "^5.0.1",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.32",
    "postcss-modules": "^9.0.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.107.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
